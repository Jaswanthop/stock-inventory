# ---------------------------------------------------------------------------
# StockPilot — environment variables
# Copy this file to `.env` in the project root and fill in your values.
# ---------------------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas or a local mongod)
# Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/stockpilot?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/stockpilot

# Long random string used to sign JWT access tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Server port (Render sets PORT automatically)
PORT=5000

# development | production
NODE_ENV=development

# Bootstrap administrator. Created automatically when the database has no users.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@stockpilot.dev
ADMIN_PASSWORD=Admin@12345

# Set to "true" to load demo categories, suppliers, products and movements
# the first time the server starts with an empty database.
SEED_DEMO_DATA=false

# Optional: only needed if the React app is hosted separately from the API.
# CORS_ORIGIN=https://your-frontend.example
# VITE_API_URL=https://your-api.onrender.com/api
